{
  "name": "aijarin",
  "version": "1.0.0",
  "private": true,
  "description": "Gamified AI-powered LMS for jalur afirmasi students — SMA Negeri 20 Surabaya",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
